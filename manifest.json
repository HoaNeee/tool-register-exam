{
  "manifest_version": 3,
  "name": "React Dashboard Extension",
  "version": "1.0.0",
  "description": "Chrome Extension Dashboard build với React và Vite",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://localhost:5173/*"],
  "action": {
    "default_title": "Mở Dashboard"
  },
   "options_page": "index.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
